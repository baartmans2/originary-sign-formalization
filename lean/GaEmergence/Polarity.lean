import GaEmergence.Graphs

/-!
# Polarity: the positive as the negation of a negation

**One rule, applied recursively.** A center on something says "not that":
* a claim (a center on two signs) says "not together";
* a center on a movement that says φ says "not φ" (`Says.meta`).

So a center on a claim says "not (not together)", whose truth condition is exactly
"together" (`affirm`). Nothing new is added: the positive is generated by applying the
originary negation twice.

**Assertion.** A movement that says something is *embedded* if a later center takes a
movement of the same kind as its target. It is *asserted* if it is not embedded. The claim
inside "not (not together)" is embedded, so it is not asserted.

**Partial universality** (`partial_universality`). For any objects, any pairs `D` to deny,
any pairs `A` to affirm (disjoint from `D`) and any arrangement `H` of which pairs are
together, there is a history satisfying every axiom (kinematics included) in which:
* each pair in `D` is asserted "not together", true iff it is not together in `H`;
* each pair in `A` is asserted "not (not together)", true iff it is together in `H`;
* nothing else is asserted about togetherness, so every other pair is left **unsaid**.

No closed-world assumption is needed: affirmed, denied and unsaid are three different states.
-/

namespace GA.Completion

set_option linter.constructorNameAsVariable false

/-- Formulas about togetherness. -/
inductive Fml (O : Type) where
  | tog : O → O → Fml O
  | neg : Fml O → Fml O

section
variable {P O M : Type} (W : World P O M)

def Eval (t : Nat) : Fml O → Prop
  | .tog o1 o2 => Together W t o1 o2
  | .neg φ => ¬ Eval t φ

/-- What a movement says. -/
inductive Says : Nat → P → Fml O → Prop where
  /-- a claim on two signs says "not together" -/
  | claim {t t' s1 s2 : Nat} {r1 r2 p q : P} {o1 o2 : O} :
      Claim W t t' (.act s1 r1) (.act s2 r2) p q → Descends W s1 r1 o1 → Descends W s2 r2 o2 →
      Says t p (.neg (.tog o1 o2))
  /-- a center on a movement that says φ says "not φ" -/
  | meta {t t' s : Nat} {r p q : P} {φ : Fml O} :
      Declarative W t t' s r p q → Says s r φ → Says t p (.neg φ)

/-- Some later center takes a movement of the same kind as its target. -/
def Embedded (t : Nat) (p : P) : Prop :=
  ∃ t2 t2' s r p2 q2, Declarative W t2 t2' s r p2 q2 ∧
    ∃ m m', W.mv s r = some m ∧ W.mv t p = some m' ∧ W.sim m' m

def Asserted (t : Nat) (p : P) (φ : Fml O) : Prop := Says W t p φ ∧ ¬ Embedded W t p

/-- Everything said is a negation: the originary "don't" is always outermost. -/
theorem says_neg {t : Nat} {p : P} {φ : Fml O} (h : Says W t p φ) : ∃ ψ, φ = .neg ψ := by
  cases h with
  | claim => exact ⟨_, rfl⟩
  | meta => exact ⟨_, rfl⟩

/-- **The positive is the negation of a negation.** A center on a claim says
"not (not together)", which holds exactly when the objects are together. -/
theorem affirm {t t' s : Nat} {r p q : P} {o1 o2 : O}
    (hD : Declarative W t t' s r p q) (hS : Says W s r (.neg (.tog o1 o2))) :
    Says W t p (.neg (.neg (.tog o1 o2))) ∧
      (Eval W t (.neg (.neg (.tog o1 o2))) ↔ Together W t o1 o2) :=
  ⟨.meta hD hS, ⟨fun h => Classical.byContradiction h, fun h h' => h' h⟩⟩

/-- **A claim and its negation are never both true.** -/
theorem no_contradiction (u : Nat) (φ : Fml O) :
    ¬ (Eval W u (.neg φ) ∧ Eval W u (.neg (.neg φ))) :=
  fun ⟨h1, h2⟩ => h2 h1

end

/-! ## The construction -/

/-- Forms: reach and sign for an object, the claim form on two signs, and the denial form
on a claim (which begins like the claim and matches nothing else). -/
inductive Fr | reach (i : Nat) | sign (i : Nat) | claim (i j : Nat) | deny (i j : Nat)
  deriving DecidableEq

def simF2 : Fr → Fr → Prop
  | .reach i, .reach j => i = j
  | .sign i, .sign j => i = j
  | .claim i j, .claim k l => i = k ∧ j = l
  | .deny i j, .deny k l => i = k ∧ j = l
  | .reach i, .sign j => i = j
  | .sign i, .reach j => i = j
  | _, _ => False

def opensF2 (m' m : Fr) : Prop :=
  simF2 m' m ∨ (∃ i j, m' = .claim i j ∧ (m = .sign i ∨ m = .sign j)) ∨
    (∃ i j, m' = .deny i j ∧ m = .claim i j)

/-- The object of a reach or sign form. -/
def objF : Fr → Option Nat
  | .reach i => some i
  | .sign i => some i
  | _ => none

theorem sim_objF {m' m : Fr} {o : Nat} (h : simF2 m' m) (ho : objF m = some o) :
    objF m' = some o := by
  cases m' <;> cases m <;> simp [simF2, objF] at h ho ⊢ <;> omega

namespace Univ2

abbrev vcond (t : Nat) (p : Pp) : Prop :=
  ((t % 8 = 0 ∨ t % 8 = 4) ∧ p = .a) ∨ ((t % 8 = 1 ∨ t % 8 = 5) ∧ p = .b)

/-- In a block starting at `base`: `b` moves at r = 0, 4 and `a` at r = 1, 5. -/
abbrev bcond (base t : Nat) (p : Pp) : Prop :=
  (((t - base) % 8 = 0 ∨ (t - base) % 8 = 4) ∧ p = .b) ∨
  (((t - base) % 8 = 1 ∨ (t - base) % 8 = 5) ∧ p = .a)

/-- Who perceives whom in such a block. -/
abbrev pcond (base t : Nat) (q p : Pp) : Prop :=
  (((t - base) % 8 = 0 ∨ (t - base) % 8 = 4) ∧ q = .a ∧ p = .b) ∨
  (((t - base) % 8 = 1 ∨ (t - base) % 8 = 5) ∧ q = .b ∧ p = .a)

/-- Objects at `8i …`, claims for the pairs in `G` at `8n + 8k …`, denials of the claims for
the pairs in `N` at `8n + 8|G| + 8m …`. -/
def mv (n : Nat) (G N : List (Nat × Nat)) (t : Nat) (p : Pp) : Option Fr :=
  if t < 8 * n then
    (if vcond t p then some (.reach (t / 8))
     else if t % 8 = 6 ∧ p = .a then some (.sign (t / 8)) else none)
  else if t < 8 * n + 8 * G.length then
    match G[(t - 8 * n) / 8]? with
    | some (i, j) => if bcond (8 * n) t p then some (.claim i j) else none
    | none => none
  else
    match N[(t - (8 * n + 8 * G.length)) / 8]? with
    | some (i, j) => if bcond (8 * n + 8 * G.length) t p then some (.deny i j) else none
    | none => none

def heads (n t : Nat) (p : Pp) (o : Nat) : Prop := t < 8 * n ∧ o = t / 8 ∧ vcond t p

def within (n : Nat) (H : List (Nat × Nat)) (t : Nat) (p : Pp) (o : Nat) : Prop :=
  (t < 8 * n ∧ o = t / 8 ∧ t % 8 ≤ 5 ∧ (p = .a ∨ p = .b)) ∨
  ∃ x y, p = .w x y ∧ (x, y) ∈ H ∧ (o = x ∨ o = y)

def perceives (n : Nat) (G N : List (Nat × Nat)) (t : Nat) (q p : Pp) : Prop :=
  (t < 8 * n ∧ (((t % 8 = 0 ∨ t % 8 = 4) ∧ q = .b ∧ p = .a) ∨
                ((t % 8 = 1 ∨ t % 8 = 5) ∧ q = .a ∧ p = .b))) ∨
  (8 * n ≤ t ∧ t < 8 * n + 8 * G.length ∧ (∃ e, G[(t - 8 * n) / 8]? = some e) ∧
    pcond (8 * n) t q p) ∨
  (8 * n + 8 * G.length ≤ t ∧ (∃ e, N[(t - (8 * n + 8 * G.length)) / 8]? = some e) ∧
    pcond (8 * n + 8 * G.length) t q p)

def W (n : Nat) (G N H : List (Nat × Nat)) : World Pp Nat Fr where
  opens := opensF2
  sim := simF2
  mv := mv n G N
  heads := heads n
  contact _ _ _ := False
  within := within n H
  perceives := perceives n G N
  win := 1
  retained _ _ := False

variable {n : Nat} {G N H : List (Nat × Nat)}

theorem idx_lt {l : List (Nat × Nat)} {k : Nat} {e : Nat × Nat} (h : l[k]? = some e) :
    k < l.length := by
  rcases List.getElem?_eq_some_iff.mp h with ⟨hk, _⟩; exact hk

/-! ### The movement table -/

theorem mv_cases {t : Nat} {p : Pp} {m : Fr} (h : mv n G N t p = some m) :
    (t < 8*n ∧ vcond t p ∧ m = .reach (t/8)) ∨
    (t < 8*n ∧ t % 8 = 6 ∧ p = .a ∧ m = .sign (t/8)) ∨
    (8*n ≤ t ∧ ∃ i j, G[(t - 8*n)/8]? = some (i, j) ∧ m = .claim i j) ∨
    (8*n + 8*G.length ≤ t ∧ ∃ i j, N[(t - (8*n + 8*G.length))/8]? = some (i, j) ∧
      m = .deny i j) := by
  unfold mv at h
  by_cases ht : t < 8 * n
  · rw [if_pos ht] at h
    by_cases hc : vcond t p
    · rw [if_pos hc] at h; cases h; exact Or.inl ⟨ht, hc, rfl⟩
    · rw [if_neg hc] at h
      by_cases h6 : t % 8 = 6 ∧ p = .a
      · rw [if_pos h6] at h; cases h; exact Or.inr (Or.inl ⟨ht, h6.1, h6.2, rfl⟩)
      · rw [if_neg h6] at h; cases h
  · rw [if_neg ht] at h
    by_cases ht2 : t < 8 * n + 8 * G.length
    · rw [if_pos ht2] at h
      cases hg : G[(t - 8 * n) / 8]? with
      | none => rw [hg] at h; cases h
      | some e =>
        obtain ⟨i, j⟩ := e
        rw [hg] at h
        have h' : (if bcond (8 * n) t p then some (Fr.claim i j) else none) = some m := h
        by_cases hc : bcond (8 * n) t p
        · rw [if_pos hc] at h'; cases h'
          exact Or.inr (Or.inr (Or.inl ⟨by omega, i, j, rfl, rfl⟩))
        · rw [if_neg hc] at h'; cases h'
    · rw [if_neg ht2] at h
      cases hg : N[(t - (8 * n + 8 * G.length)) / 8]? with
      | none => rw [hg] at h; cases h
      | some e =>
        obtain ⟨i, j⟩ := e
        rw [hg] at h
        have h' : (if bcond (8 * n + 8 * G.length) t p then some (Fr.deny i j) else none) =
          some m := h
        by_cases hc : bcond (8 * n + 8 * G.length) t p
        · rw [if_pos hc] at h'; cases h'
          exact Or.inr (Or.inr (Or.inr ⟨by omega, i, j, rfl, rfl⟩))
        · rw [if_neg hc] at h'; cases h'

theorem mv_reach {t : Nat} {p : Pp} {o : Nat} (ht : t < 8*n) (hc : vcond t p)
    (ho : o = t / 8) : mv n G N t p = some (.reach o) := by
  unfold mv; rw [if_pos ht, if_pos hc, ho]

theorem mv_sign {t : Nat} {o : Nat} (ht : t < 8*n) (h6 : t % 8 = 6) (ho : o = t / 8) :
    mv n G N t .a = some (.sign o) := by
  have hc : ¬ vcond t .a := by simp [vcond]; omega
  unfold mv; rw [if_pos ht, if_neg hc, if_pos ⟨h6, rfl⟩, ho]

theorem mv_none_v {t : Nat} {p : Pp} (ht : t < 8*n) (hc : ¬ vcond t p)
    (h6 : ¬ (t % 8 = 6 ∧ p = .a)) : mv n G N t p = none := by
  unfold mv; rw [if_pos ht, if_neg hc, if_neg h6]

theorem mv_claim {t : Nat} {p : Pp} {i j : Nat} (ht : 8*n ≤ t) (ht2 : t < 8*n + 8*G.length)
    (hg : G[(t - 8*n)/8]? = some (i, j)) (hc : bcond (8*n) t p) :
    mv n G N t p = some (.claim i j) := by
  unfold mv
  rw [if_neg (by omega), if_pos ht2, hg]
  show (if bcond (8 * n) t p then some (Fr.claim i j) else none) = _
  rw [if_pos hc]

theorem mv_none_e {t : Nat} {p : Pp} (ht : 8*n ≤ t) (ht2 : t < 8*n + 8*G.length)
    (hc : ¬ bcond (8*n) t p) : mv n G N t p = none := by
  unfold mv
  rw [if_neg (by omega), if_pos ht2]
  cases hg : G[(t - 8 * n) / 8]? with
  | none => rfl
  | some e =>
    obtain ⟨i, j⟩ := e
    show (if bcond (8 * n) t p then some (Fr.claim i j) else none) = none
    rw [if_neg hc]

theorem mv_deny {t : Nat} {p : Pp} {i j : Nat} (ht : 8*n + 8*G.length ≤ t)
    (hg : N[(t - (8*n + 8*G.length))/8]? = some (i, j)) (hc : bcond (8*n + 8*G.length) t p) :
    mv n G N t p = some (.deny i j) := by
  unfold mv
  rw [if_neg (by omega), if_neg (by omega), hg]
  show (if bcond (8 * n + 8 * G.length) t p then some (Fr.deny i j) else none) = _
  rw [if_pos hc]

theorem mv_none_m {t : Nat} {p : Pp} (ht : 8*n + 8*G.length ≤ t)
    (hc : ¬ bcond (8*n + 8*G.length) t p) : mv n G N t p = none := by
  unfold mv
  rw [if_neg (by omega), if_neg (by omega)]
  cases hg : N[(t - (8 * n + 8 * G.length)) / 8]? with
  | none => rfl
  | some e =>
    obtain ⟨i, j⟩ := e
    show (if bcond (8 * n + 8 * G.length) t p then some (Fr.deny i j) else none) = none
    rw [if_neg hc]

theorem claim_at {t i j : Nat} {p : Pp} (h : mv n G N t p = some (.claim i j)) :
    (i, j) ∈ G := by
  rcases mv_cases h with ⟨_, _, h'⟩ | ⟨_, _, _, h'⟩ | ⟨_, i', j', hg, h'⟩ | ⟨_, _, _, _, h'⟩
  · cases h'
  · cases h'
  · cases h'; exact List.mem_iff_getElem?.mpr ⟨_, hg⟩
  · cases h'

theorem deny_at {t i j : Nat} {p : Pp} (h : mv n G N t p = some (.deny i j)) :
    (i, j) ∈ N := by
  rcases mv_cases h with ⟨_, _, h'⟩ | ⟨_, _, _, h'⟩ | ⟨_, _, _, _, h'⟩ | ⟨_, i', j', hg, h'⟩
  · cases h'
  · cases h'
  · cases h'
  · cases h'; exact List.mem_iff_getElem?.mpr ⟨_, hg⟩

theorem sign_at {s x : Nat} {r : Pp} (h : mv n G N s r = some (.sign x)) :
    s = 8*x+6 ∧ r = .a := by
  rcases mv_cases h with ⟨_, _, h'⟩ | ⟨_, h6, hr, h'⟩ | ⟨_, _, _, _, h'⟩ | ⟨_, _, _, _, h'⟩
  · cases h'
  · cases h'; exact ⟨by omega, hr⟩
  · cases h'
  · cases h'

/-! ### Axioms and kinematics -/

theorem axioms : Axioms (W n G N H) where
  heads_within t p o h := by
    obtain ⟨ht, ho, hc⟩ := h
    refine Or.inl ⟨ht, ho, ?_, ?_⟩
    · rcases hc with ⟨h, _⟩ | ⟨h, _⟩ <;> omega
    · rcases hc with ⟨_, hp⟩ | ⟨_, hp⟩ <;> simp [hp]
  heads_moving t p o h := ⟨_, mv_reach h.1 h.2.2 rfl⟩
  contact_heads _ _ _ h := h.elim
  perceives_other t q p h := by
    rcases h with ⟨ht, ⟨hr, rfl, rfl⟩ | ⟨hr, rfl, rfl⟩⟩ |
      ⟨ht, ht2, ⟨⟨i, j⟩, hg⟩, ⟨hr, rfl, rfl⟩ | ⟨hr, rfl, rfl⟩⟩ |
      ⟨ht, ⟨⟨i, j⟩, hg⟩, ⟨hr, rfl, rfl⟩ | ⟨hr, rfl, rfl⟩⟩
    · exact ⟨by decide, _, mv_reach ht (Or.inl ⟨hr, rfl⟩) rfl⟩
    · exact ⟨by decide, _, mv_reach ht (Or.inr ⟨hr, rfl⟩) rfl⟩
    · exact ⟨by decide, _, mv_claim ht ht2 hg (Or.inl ⟨hr, rfl⟩)⟩
    · exact ⟨by decide, _, mv_claim ht ht2 hg (Or.inr ⟨hr, rfl⟩)⟩
    · exact ⟨by decide, _, mv_deny ht hg (Or.inl ⟨hr, rfl⟩)⟩
    · exact ⟨by decide, _, mv_deny ht hg (Or.inr ⟨hr, rfl⟩)⟩
  sim_refl m := by cases m <;> simp [W, simF2]
  sim_symm m m' h := by
    cases m <;> cases m' <;> simp [W, simF2] at h ⊢ <;> omega
  sim_opens _ _ h := Or.inl h
  retention _ _ h := h.elim

theorem kinematics : Kinematics (W n G N H) where
  transfer s t r p o m m' _ hm hh hm' ho hw := by
    obtain ⟨hs8, hos, hcs⟩ := hh
    have hm0 : m = .reach o := by
      have h1 : mv n G N s r = some (.reach o) := mv_reach hs8 hcs hos
      have h2 : mv n G N s r = some m := hm
      rw [h1] at h2; cases h2; rfl
    subst hm0
    have hm'' : mv n G N t p = some m' := hm'
    rcases ho with hsim | ⟨i, j, rfl, hx⟩ | ⟨i, j, rfl, hx⟩
    · cases m' with
      | reach o' =>
        have he : o' = o := hsim
        subst he
        rcases mv_cases hm'' with ⟨ht, hc, he⟩ | ⟨_, _, _, he⟩ | ⟨_, _, _, _, he⟩ |
          ⟨_, _, _, _, he⟩
        · cases he; exact ⟨ht, rfl, hc⟩
        · cases he
        · cases he
        · cases he
      | sign o' =>
        have he : o' = o := hsim
        subst he
        rcases mv_cases hm'' with ⟨_, _, he⟩ | ⟨_, h6, hp, he⟩ | ⟨_, _, _, _, he⟩ |
          ⟨_, _, _, _, he⟩
        · cases he
        · subst hp
          rcases hw with ⟨_, _, h5, _⟩ | ⟨x, y, hpw, _⟩
          · omega
          · cases hpw
        · cases he
        · cases he
      | claim i j => exact hsim.elim
      | deny i j => exact hsim.elim
    · rcases hx with h | h <;> cases h
    · cases hx

/-! ### Objects -/

theorem joint_v {i : Nat} (hi : i < n) (r : Nat) (hr : r = 0 ∨ r = 4) :
    Joint (W n G N H) (8*i+r) (8*i+r+1) (.obj i) .a .b :=
  ⟨by decide, by omega, by show _ ≤ _ + 1; omega,
    ⟨⟨by omega, by omega, Or.inl ⟨by omega, rfl⟩⟩, fun h => h⟩,
    ⟨⟨by omega, by omega, Or.inr ⟨by omega, rfl⟩⟩, fun h => h⟩,
    Or.inl ⟨by omega, Or.inl ⟨by omega, rfl, rfl⟩⟩,
    Or.inl ⟨by omega, Or.inr ⟨by omega, rfl, rfl⟩⟩⟩

theorem ostensive_vertex {i : Nat} (hi : i < n) :
    Ostensive (W n G N H) (8*i) (8*i+1) i .a .b := by
  refine ⟨joint_v hi 0 (Or.inl rfl), ⟨8*i+4, 8*i+4+1, by omega, joint_v hi 4 (Or.inr rfl),
    .reach i, .reach i, mv_reach (by omega) (Or.inl ⟨by omega, rfl⟩) (by omega),
    mv_reach (by omega) (Or.inl ⟨by omega, rfl⟩) (by omega), rfl⟩,
    ⟨8*i+2, ⟨8*i+3, by omega, by show _ ≤ _ + 1; omega,
      Or.inl ⟨by omega, by omega, by omega, Or.inr rfl⟩⟩, ?_, ?_⟩⟩
  · rintro ⟨_, _, _, h2, _⟩
    have : mv n G N (8*i+2) .a = none :=
      mv_none_v (by omega) (by simp [vcond]; omega) (fun h => by omega)
    rw [show (W n G N H).mv (8*i+2) .a = mv n G N (8*i+2) .a from rfl, this] at h2
    cases h2
  · intro u' h1 h2 hs
    have hu : u' = 8*i+3 := by simp [W] at h2; omega
    subst hu
    obtain ⟨_, _, hc⟩ := hs.1
    rcases hc with ⟨_, h⟩ | ⟨h, _⟩
    · cases h
    · omega

theorem descends_vertex {i : Nat} (hi : i < n) : Descends (W n G N H) (8*i+6) .a i :=
  Descends.step (W := W n G N H) (s := 8*i) (r := .a) (m := Fr.reach i) (m' := Fr.sign i)
    (by omega) (mv_reach (by omega) (Or.inl ⟨by omega, rfl⟩) (by omega))
    (mv_sign (by omega) (by omega) (by omega)) rfl
    (Descends.root (ostensive_vertex hi))

/-- What a movement stands for by lineage is fixed by its form. -/
theorem descends_obj {s : Nat} {r : Pp} {o : Nat} (hD : Descends (W n G N H) s r o) :
    ∃ m, mv n G N s r = some m ∧ objF m = some o := by
  induction hD with
  | root hj =>
    obtain ⟨ht, ho, hc⟩ := hj.1.2.2.2.1.1
    exact ⟨_, mv_reach ht hc ho, rfl⟩
  | @step s t r p o m1 m2 _ hmr hmp hsim _ ih =>
    obtain ⟨m, hm, ho⟩ := ih
    have hm1 : mv n G N s r = some m1 := hmr
    rw [hm1] at hm
    cases hm
    exact ⟨m2, hmp, sim_objF hsim ho⟩

/-! ### Claims -/

theorem hg_at {l : List (Nat × Nat)} {base k i j : Nat} (hk : l[k]? = some (i, j)) (r : Nat)
    (hr : r < 8) : l[(base + 8*k + r - base)/8]? = some (i, j) := by
  rw [show (base + 8*k + r - base)/8 = k by omega]; exact hk

theorem mv_claimAt {k i j r : Nat} {p : Pp} (hk : G[k]? = some (i, j)) (hr : r < 8)
    (hc : bcond (8*n) (8*n+8*k+r) p) : mv n G N (8*n+8*k+r) p = some (.claim i j) :=
  mv_claim (by omega) (by have := idx_lt hk; omega) (hg_at hk r hr) hc

theorem susp_claim {k i j x : Nat} (hk : G[k]? = some (i, j)) (hx : x = i ∨ x = j)
    (hxn : x < n) {r : Nat} {p : Pp} (hr : r < 8) (hc : bcond (8*n) (8*n+8*k+r) p) :
    Suspended (W n G N H) (8*n+8*k+r) p (.act (8*x+6) .a) := by
  have hs : mv n G N (8*x+6) .a = some (.sign x) := mv_sign (by omega) (by omega) (by omega)
  have hcl := mv_claimAt (N := N) hk hr hc
  refine ⟨⟨by omega, .sign x, .claim i j, hs, hcl, Or.inr (Or.inl ⟨i, j, rfl, ?_⟩)⟩, ?_⟩
  · rcases hx with rfl | rfl
    · exact Or.inl rfl
    · exact Or.inr rfl
  · rintro ⟨m, m', h1, h2, hsim⟩
    have h1' : mv n G N (8*x+6) .a = some m := h1
    have h2' : mv n G N (8*n+8*k+r) p = some m' := h2
    rw [hs] at h1'; rw [hcl] at h2'
    cases h1'; cases h2'
    exact hsim

theorem joint_e {k i j x : Nat} (hk : G[k]? = some (i, j)) (hx : x = i ∨ x = j)
    (hxn : x < n) (r : Nat) (hr : r = 0 ∨ r = 4) :
    Joint (W n G N H) (8*n+8*k+r) (8*n+8*k+r+1) (.act (8*x+6) .a) .b .a := by
  have hlt := idx_lt hk
  exact ⟨by decide, by omega, by show _ ≤ _ + 1; omega,
    susp_claim hk hx hxn (by omega) (Or.inl ⟨by omega, rfl⟩),
    susp_claim (r := r+1) hk hx hxn (by omega) (Or.inr ⟨by omega, rfl⟩),
    Or.inr (Or.inl ⟨by omega, by omega, ⟨_, hg_at hk r (by omega)⟩,
      Or.inl ⟨by omega, rfl, rfl⟩⟩),
    Or.inr (Or.inl ⟨by omega, by omega, ⟨_, hg_at hk (r+1) (by omega)⟩,
      Or.inr ⟨by omega, rfl, rfl⟩⟩)⟩

theorem dependent_e {k i j x : Nat} (hk : G[k]? = some (i, j)) (hx : x = i ∨ x = j)
    (hxn : x < n) : Dependent (W n G N H) (8*n+8*k) (.act (8*x+6) .a) .b .a := by
  have hlt := idx_lt hk
  refine ⟨⟨8*n+8*k+4, 8*n+8*k+4+1, by omega, joint_e hk hx hxn 4 (Or.inr rfl),
      .claim i j, .claim i j, mv_claimAt hk (r := 0) (by omega) (Or.inl ⟨by omega, rfl⟩),
      mv_claimAt hk (r := 4) (by omega) (Or.inl ⟨by omega, rfl⟩), ⟨rfl, rfl⟩⟩,
    ⟨8*n+8*k+2, (by omega : 8*x+6 < 8*n+8*k+2), ?_, ?_⟩⟩
  · rintro ⟨_, _, _, h2, _⟩
    have : mv n G N (8*n+8*k+2) .b = none :=
      mv_none_e (by omega) (by omega) (by simp [bcond]; omega)
    rw [show (W n G N H).mv (8*n+8*k+2) .b = mv n G N (8*n+8*k+2) .b from rfl, this] at h2
    cases h2
  · intro u' h1 h2 hs
    have hu : u' = 8*n+8*k+3 := by simp [W] at h2; omega
    subst hu
    obtain ⟨_, _, _, _, h3, _⟩ := hs.1
    have : mv n G N (8*n+8*k+3) .a = none :=
      mv_none_e (by omega) (by omega) (by simp [bcond]; omega)
    rw [show (W n G N H).mv (8*n+8*k+3) .a = mv n G N (8*n+8*k+3) .a from rfl, this] at h3
    cases h3

theorem claim_edge {k i j : Nat} (hk : G[k]? = some (i, j)) (hi : i < n) (hj : j < n)
    (hij : i ≠ j) :
    Claim (W n G N H) (8*n+8*k) (8*n+8*k+1) (.act (8*i+6) .a) (.act (8*j+6) .a) .b .a :=
  ⟨fun h => hij (by injection h with h1; omega),
    joint_e hk (Or.inl rfl) hi 0 (Or.inl rfl), joint_e hk (Or.inr rfl) hj 0 (Or.inl rfl),
    dependent_e hk (Or.inl rfl) hi, dependent_e hk (Or.inr rfl) hj⟩

theorem says_claim {k i j : Nat} (hk : G[k]? = some (i, j)) (hi : i < n) (hj : j < n)
    (hij : i ≠ j) : Says (W n G N H) (8*n+8*k) .b (.neg (.tog i j)) :=
  .claim (claim_edge hk hi hj hij) (descends_vertex hi) (descends_vertex hj)

/-! ### Denials of claims -/

theorem mv_denyAt {m i j r : Nat} {p : Pp} (hm : N[m]? = some (i, j)) (hr : r < 8)
    (hc : bcond (8*n+8*G.length) (8*n+8*G.length+8*m+r) p) :
    mv n G N (8*n+8*G.length+8*m+r) p = some (.deny i j) :=
  mv_deny (by omega) (hg_at hm r hr) hc

theorem susp_deny {k m i j : Nat} (hk : G[k]? = some (i, j)) (hm : N[m]? = some (i, j))
    {r : Nat} {p : Pp} (hr : r < 8) (hc : bcond (8*n+8*G.length) (8*n+8*G.length+8*m+r) p) :
    Suspended (W n G N H) (8*n+8*G.length+8*m+r) p (.act (8*n+8*k) .b) := by
  have hlt := idx_lt hk
  have hcl : mv n G N (8*n+8*k) .b = some (.claim i j) :=
    mv_claimAt hk (r := 0) (by omega) (Or.inl ⟨by omega, rfl⟩)
  have hd := mv_denyAt (n := n) (G := G) hm hr hc
  refine ⟨⟨by omega, .claim i j, .deny i j, hcl, hd, Or.inr (Or.inr ⟨i, j, rfl, rfl⟩)⟩, ?_⟩
  rintro ⟨m1, m2, h1, h2, hsim⟩
  have h1' : mv n G N (8*n+8*k) .b = some m1 := h1
  have h2' : mv n G N (8*n+8*G.length+8*m+r) p = some m2 := h2
  rw [hcl] at h1'; rw [hd] at h2'
  cases h1'; cases h2'
  exact hsim

theorem joint_m {k m i j : Nat} (hk : G[k]? = some (i, j)) (hm : N[m]? = some (i, j))
    (r : Nat) (hr : r = 0 ∨ r = 4) :
    Joint (W n G N H) (8*n+8*G.length+8*m+r) (8*n+8*G.length+8*m+r+1)
      (.act (8*n+8*k) .b) .b .a :=
  ⟨by decide, by omega, by show _ ≤ _ + 1; omega,
    susp_deny hk hm (by omega) (Or.inl ⟨by omega, rfl⟩),
    susp_deny (r := r+1) hk hm (by omega) (Or.inr ⟨by omega, rfl⟩),
    Or.inr (Or.inr ⟨by omega, ⟨_, hg_at hm r (by omega)⟩, Or.inl ⟨by omega, rfl, rfl⟩⟩),
    Or.inr (Or.inr ⟨by omega, ⟨_, hg_at hm (r+1) (by omega)⟩, Or.inr ⟨by omega, rfl, rfl⟩⟩)⟩

theorem decl_meta {k m i j : Nat} (hk : G[k]? = some (i, j)) (hm : N[m]? = some (i, j)) :
    Declarative (W n G N H) (8*n+8*G.length+8*m) (8*n+8*G.length+8*m+1) (8*n+8*k) .b .b .a := by
  have hlt := idx_lt hk
  refine ⟨joint_m hk hm 0 (Or.inl rfl),
    ⟨8*n+8*G.length+8*m+4, 8*n+8*G.length+8*m+4+1, by omega, joint_m hk hm 4 (Or.inr rfl),
      .deny i j, .deny i j, mv_denyAt hm (r := 0) (by omega) (Or.inl ⟨by omega, rfl⟩),
      mv_denyAt hm (r := 4) (by omega) (Or.inl ⟨by omega, rfl⟩), ⟨rfl, rfl⟩⟩,
    ⟨8*n+8*G.length+8*m+2, (by omega : 8*n+8*k < 8*n+8*G.length+8*m+2), ?_, ?_⟩⟩
  · rintro ⟨_, _, _, h2, _⟩
    have : mv n G N (8*n+8*G.length+8*m+2) .b = none :=
      mv_none_m (by omega) (by simp [bcond]; omega)
    rw [show (W n G N H).mv (8*n+8*G.length+8*m+2) .b =
      mv n G N (8*n+8*G.length+8*m+2) .b from rfl, this] at h2
    cases h2
  · intro u' h1 h2 hs
    have hu : u' = 8*n+8*G.length+8*m+3 := by simp [W] at h2; omega
    subst hu
    obtain ⟨_, _, _, _, h3, _⟩ := hs.1
    have : mv n G N (8*n+8*G.length+8*m+3) .a = none :=
      mv_none_m (by omega) (by simp [bcond]; omega)
    rw [show (W n G N H).mv (8*n+8*G.length+8*m+3) .a =
      mv n G N (8*n+8*G.length+8*m+3) .a from rfl, this] at h3
    cases h3

theorem embedded_claim {k m i j : Nat} (hk : G[k]? = some (i, j))
    (hm : N[m]? = some (i, j)) {t : Nat} {p : Pp}
    (hmv : mv n G N t p = some (.claim i j)) : Embedded (W n G N H) t p := by
  have hlt := idx_lt hk
  exact ⟨_, _, _, _, _, _, decl_meta hk hm, .claim i j, .claim i j,
    mv_claimAt hk (r := 0) (by omega) (Or.inl ⟨by omega, rfl⟩), hmv, ⟨rfl, rfl⟩⟩

/-! ### What can be said, and what is asserted -/

theorem susp_act {t s : Nat} {p r : Pp} (h : Suspended (W n G N H) t p (.act s r)) :
    ∃ m m', mv n G N s r = some m ∧ mv n G N t p = some m' ∧
      ((∃ i j, m' = .claim i j ∧ (m = .sign i ∨ m = .sign j)) ∨
       (∃ i j, m' = .deny i j ∧ m = .claim i j)) := by
  obtain ⟨⟨_, m, m', hm, hm', ho⟩, hnc⟩ := h
  rcases ho with hs | hc
  · exact absurd ⟨m, m', hm, hm', hs⟩ hnc
  · exact ⟨m, m', hm, hm', hc⟩

/-- Everything said is either a claim on a pair of `G` (made with its claim form) or a
denial of such a claim, made with the denial form of a pair of `N`. -/
theorem says_inv {t : Nat} {p : Pp} {φ : Fml Nat} (h : Says (W n G N H) t p φ) :
    (∃ i j, (i, j) ∈ G ∧ mv n G N t p = some (.claim i j) ∧
      (φ = .neg (.tog i j) ∨ φ = .neg (.tog j i))) ∨
    (∃ i j, (i, j) ∈ N ∧ mv n G N t p = some (.deny i j) ∧
      (φ = .neg (.neg (.tog i j)) ∨ φ = .neg (.neg (.tog j i)))) := by
  induction h with
  | @claim t t' s1 s2 r1 r2 p q o1 o2 hc hd1 hd2 =>
    left
    obtain ⟨hne, hj1, hj2, _, _⟩ := hc
    obtain ⟨m1, m1', hm1, hm1', hk1⟩ := susp_act hj1.2.2.2.1
    obtain ⟨m2, m2', hm2, hm2', hk2⟩ := susp_act hj2.2.2.2.1
    obtain ⟨x1, hx1m, hx1⟩ := descends_obj hd1
    obtain ⟨x2, hx2m, hx2⟩ := descends_obj hd2
    rw [hm1] at hx1m; cases hx1m
    rw [hm2] at hx2m; cases hx2m
    rcases hk1 with ⟨i, j, rfl, hs1⟩ | ⟨i, j, rfl, rfl⟩
    · rcases hk2 with ⟨i', j', rfl, hs2⟩ | ⟨i', j', rfl, rfl⟩
      · rw [hm1'] at hm2'; cases hm2'
        refine ⟨i, j, claim_at hm1', hm1', ?_⟩
        rcases hs1 with rfl | rfl <;> rcases hs2 with rfl | rfl <;>
          simp only [objF, Option.some.injEq] at hx1 hx2 <;> subst hx1 <;> subst hx2
        · obtain ⟨e1, e1'⟩ := sign_at hm1
          obtain ⟨e2, e2'⟩ := sign_at hm2
          exact absurd (by rw [e1, e1', e2, e2']) hne
        · exact Or.inl rfl
        · exact Or.inr rfl
        · obtain ⟨e1, e1'⟩ := sign_at hm1
          obtain ⟨e2, e2'⟩ := sign_at hm2
          exact absurd (by rw [e1, e1', e2, e2']) hne
      · rw [hm1'] at hm2'; cases hm2'
    · simp [objF] at hx1
  | @meta t t' s r p q φ hd _ ih =>
    right
    obtain ⟨m, m', hm, hm', hk⟩ := susp_act hd.1.2.2.2.1
    rcases ih with ⟨i, j, hG, hcl, hφ⟩ | ⟨i, j, _, hdn, _⟩
    · rw [hcl] at hm; cases hm
      rcases hk with ⟨_, _, _, hs | hs⟩ | ⟨i', j', rfl, he⟩
      · cases hs
      · cases hs
      · cases he
        refine ⟨i, j, deny_at hm', hm', ?_⟩
        rcases hφ with rfl | rfl
        · exact Or.inl rfl
        · exact Or.inr rfl
    · rw [hdn] at hm; cases hm
      rcases hk with ⟨_, _, _, hs | hs⟩ | ⟨_, _, _, he⟩
      · cases hs
      · cases hs
      · cases he

/-- Denials are never embedded: nothing begins like a denial without matching it. -/
theorem embedded_inv {t : Nat} {p : Pp} (h : Embedded (W n G N H) t p) :
    ∃ m', mv n G N t p = some m' ∧
      ((∃ i, m' = .sign i ∨ m' = .reach i) ∨ (∃ i j, m' = .claim i j ∧ (i, j) ∈ N)) := by
  obtain ⟨t2, t2', s, r, p2, q2, hd, m, m', hm, hm', hsim⟩ := h
  obtain ⟨m0, d, hm0, hd', hk⟩ := susp_act hd.1.2.2.2.1
  have hm1 : mv n G N s r = some m := hm
  rw [hm0] at hm1; cases hm1
  refine ⟨m', hm', ?_⟩
  rcases hk with ⟨i, j, rfl, hs | hs⟩ | ⟨i, j, rfl, rfl⟩
  · subst hs
    cases m' <;> simp [W, simF2] at hsim
    · exact Or.inl ⟨_, Or.inr rfl⟩
    · exact Or.inl ⟨_, Or.inl rfl⟩
  · subst hs
    cases m' <;> simp [W, simF2] at hsim
    · exact Or.inl ⟨_, Or.inr rfl⟩
    · exact Or.inl ⟨_, Or.inl rfl⟩
  · cases m' <;> simp [W, simF2] at hsim
    obtain ⟨rfl, rfl⟩ := hsim
    exact Or.inr ⟨_, _, rfl, deny_at hd'⟩

/-! ### Truth -/

theorem together_iff {t i j : Nat} (ht : 8*n ≤ t) (hij : i ≠ j) :
    Together (W n G N H) t i j ↔ (i, j) ∈ H ∨ (j, i) ∈ H := by
  constructor
  · rintro ⟨r, h1, h2⟩
    rcases h1 with ⟨h, _⟩ | ⟨x, y, rfl, hxy, hix⟩
    · omega
    · rcases h2 with ⟨h, _⟩ | ⟨x', y', he, _, hjx⟩
      · omega
      · cases he
        rcases hix with rfl | rfl <;> rcases hjx with h | h
        · exact absurd h.symm hij
        · subst h; exact Or.inl hxy
        · subst h; exact Or.inr hxy
        · exact absurd h.symm hij
  · rintro (h | h)
    · exact ⟨.w i j, Or.inr ⟨i, j, rfl, h, Or.inl rfl⟩, Or.inr ⟨i, j, rfl, h, Or.inr rfl⟩⟩
    · exact ⟨.w j i, Or.inr ⟨j, i, rfl, h, Or.inr rfl⟩, Or.inr ⟨j, i, rfl, h, Or.inl rfl⟩⟩

end Univ2

/-! ## Headline -/

/-- Two pairs are the same unordered pair. -/
def SamePair (e e' : Nat × Nat) : Prop := e = e' ∨ (e.2, e.1) = e'

/-- Pair `e` is together in arrangement `H`. -/
def InH (H : List (Nat × Nat)) (e : Nat × Nat) : Prop := e ∈ H ∨ (e.2, e.1) ∈ H

open Univ2 in
/-- **Partial universality.** For any `n` objects, pairs `D` to deny, pairs `A` to affirm
(no pair in both) and any arrangement `H`, there is a history satisfying every axiom
(kinematics included) in which:
* every pair in `D` is asserted "not together", and that assertion is true iff the pair is
  not together in `H`;
* every pair in `A` is asserted "not (not together)", and that assertion is true iff the
  pair is together in `H`;
* every assertion of "not together" is about a pair in `D`, and every assertion of
  "not (not together)" is about a pair in `A`.

Pairs in neither list are left unsaid. -/
theorem partial_universality (n : Nat) (D A H : List (Nat × Nat))
    (hD : ∀ e ∈ D, e.1 < n ∧ e.2 < n ∧ e.1 ≠ e.2)
    (hA : ∀ e ∈ A, e.1 < n ∧ e.2 < n ∧ e.1 ≠ e.2)
    (hdisj : ∀ e ∈ D, e ∉ A) :
    ∃ W : World Pp Nat Fr, Axioms W ∧ Kinematics W ∧
      (∀ e ∈ D, ∃ t p, Asserted W t p (.neg (.tog e.1 e.2)) ∧
          (Eval W t (.neg (.tog e.1 e.2)) ↔ ¬ InH H e)) ∧
      (∀ e ∈ A, ∃ t p, Asserted W t p (.neg (.neg (.tog e.1 e.2))) ∧
          (Eval W t (.neg (.neg (.tog e.1 e.2))) ↔ InH H e)) ∧
      (∀ t p i j, Asserted W t p (.neg (.tog i j)) → ∃ e ∈ D, SamePair (i, j) e) ∧
      (∀ t p i j, Asserted W t p (.neg (.neg (.tog i j))) → ∃ e ∈ A, SamePair (i, j) e) := by
  refine ⟨W n (D ++ A) A H, axioms, kinematics, ?_, ?_, ?_, ?_⟩
  · -- denied pairs
    intro e he
    obtain ⟨k, hk⟩ := List.mem_iff_getElem?.mp he
    have hkl := idx_lt hk
    have hk' : (D ++ A)[k]? = some e := by rw [List.getElem?_append_left hkl]; exact hk
    obtain ⟨h1, h2, h12⟩ := hD e he
    obtain ⟨i, j⟩ := e
    refine ⟨8*n+8*k, .b, ⟨says_claim hk' h1 h2 h12, ?_⟩, ?_⟩
    · intro hemb
      obtain ⟨m', hm', hcase⟩ := embedded_inv hemb
      have hc0 := mv_claimAt (n := n) (N := A) hk' (r := 0) (by omega) (Or.inl ⟨by omega, rfl⟩)
      simp only [Nat.add_zero] at hc0
      rw [hc0] at hm'
      cases hm'
      rcases hcase with ⟨_, h | h⟩ | ⟨i', j', h, hN⟩
      · cases h
      · cases h
      · cases h; exact hdisj _ he hN
    · show ¬ Together _ _ i j ↔ _
      rw [together_iff (by omega) h12]; rfl
  · -- affirmed pairs
    intro e he
    obtain ⟨m, hm⟩ := List.mem_iff_getElem?.mp he
    have hm' : (D ++ A)[D.length + m]? = some e := by
      rw [List.getElem?_append_right (by omega), Nat.add_sub_cancel_left]; exact hm
    obtain ⟨h1, h2, h12⟩ := hA e he
    obtain ⟨i, j⟩ := e
    have hsays := says_claim (N := A) (H := H) hm' h1 h2 h12
    refine ⟨_, .b, ⟨(affirm _ (decl_meta hm' hm) hsays).1, ?_⟩,
      (affirm _ (decl_meta hm' hm) hsays).2.trans ?_⟩
    · intro hemb
      obtain ⟨m', hm'', hcase⟩ := embedded_inv hemb
      have hd0 := mv_denyAt (n := n) (G := D ++ A) hm (r := 0) (by omega) (Or.inl ⟨by omega, rfl⟩)
      simp only [Nat.add_zero] at hd0
      rw [hd0] at hm''
      cases hm''
      rcases hcase with ⟨_, h | h⟩ | ⟨_, _, h, _⟩ <;> cases h
    · rw [together_iff (by omega) h12]; rfl
  · -- only denied pairs are asserted "not together"
    rintro t p i j ⟨hs, hne⟩
    rcases says_inv hs with ⟨i', j', hG, hcl, hφ⟩ | ⟨_, _, _, _, hφ⟩
    · rcases List.mem_append.mp hG with hD' | hA'
      · refine ⟨(i', j'), hD', ?_⟩
        rcases hφ with h | h <;> cases h
        · exact Or.inl rfl
        · exact Or.inr rfl
      · obtain ⟨m, hm⟩ := List.mem_iff_getElem?.mp hA'
        have hm' : (D ++ A)[D.length + m]? = some (i', j') := by
          rw [List.getElem?_append_right (by omega), Nat.add_sub_cancel_left]; exact hm
        exact absurd (embedded_claim hm' hm hcl) hne
    · rcases hφ with h | h <;> cases h
  · -- only affirmed pairs are asserted "not (not together)"
    rintro t p i j ⟨hs, _⟩
    rcases says_inv hs with ⟨_, _, _, _, hφ⟩ | ⟨i', j', hN, _, hφ⟩
    · rcases hφ with h | h <;> cases h
    · refine ⟨(i', j'), hN, ?_⟩
      rcases hφ with h | h <;> cases h
      · exact Or.inl rfl
      · exact Or.inr rfl

end GA.Completion
